# CaoxuBlog - Nginx 部署配置（腾讯云轻量应用服务器 / CVM 参考）
# 用法：
#   1. 将整个项目目录上传到服务器，例如 /var/www/caoxublog
#   2. 申请证书：腾讯云控制台免费 DV 证书，或 Let's Encrypt（certbot）
#   3. 把下面 your-domain.com / 证书路径改成实际值
#   4. 复制本文件到 /etc/nginx/conf.d/caoxublog.conf 后 `nginx -t && systemctl reload nginx`
#
# 说明：本项目已自托管所有前端依赖（vendor/ 目录，无 jsDelivr/unpkg 等境外 CDN），
#       因此可启用较严格的 CSP；文章静态页 post/*.html 内含一段内联脚本（用于代码高亮与目录），
#       故 script-src 需保留 'unsafe-inline'。

# HTTP 访问统一跳转 HTTPS（部署证书后建议开启）
server {
    listen 80;
    server_name your-domain.com;
    # 腾讯云默认会放行 80 端口用于验证；证书签发后取消下一行注释
    # return 301 https://$host$request_uri;
    # 临时：未配 HTTPS 时也可直接提供 HTTP 服务（剪贴板复制会降级为 execCommand）
    root /var/www/caoxublog;
    index index.html;
    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl http2;
    server_name your-domain.com;

    # SSL 证书（腾讯云免费证书 / Let's Encrypt 路径示例）
    ssl_certificate     /etc/nginx/ssl/your-domain/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/your-domain/privkey.pem;

    # 基础安全配置（按需调整）
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    root /var/www/caoxublog;
    index index.html;

    # 隐藏 Nginx 版本号
    server_tokens off;

    # gzip 压缩
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml font/woff2;
    gzip_vary on;

    # 安全响应头
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-XSS-Protection "1; mode=block" always;
    # 启用 HTTPS 后可开启 HSTS（首次部署建议先注释，证书稳定后再开）
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 内容安全策略：本站已自托管全部依赖且去除内联事件，可启用较严格策略。
    # 说明：post/*.html 静态文章页含一段内联脚本（代码高亮/目录），故 script-src 保留 'unsafe-inline'。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self';" always;

    # 静态资源缓存：带版本号（?v=）的 JS/CSS 可长缓存，页面与数据不缓存
    location ~* \.(css|js|svg|png|jpg|jpeg|webp|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    # 页面与数据每次新鲜度校验（index.json / search-index.json / md 通过 fetch 的 no-cache 已保证）
    location ~* \.(html|xml|txt|json|md)$ {
        expires -1;
        add_header Cache-Control "no-cache";
    }

    # SPA 深链（blog.html?id= 等）无需 rewrite，静态文件直接命中
    location / {
        try_files $uri $uri/ =404;
    }
}

# ============================================================
# 方案 B：腾讯云 COS 静态网站托管 / EdgeOne Pages（无 Nginx）
#   - 上传全部文件（含 vendor/、post/、search-index.json 等生成产物）
#   - 部署前在本地/CI 运行：SITE_URL=https://your-domain.com node build-index.js
#   - COS：设置默认首页 index.html；EdgeOne Pages 构建命令填
#     `node build-index.js`，输出目录为项目根
#   - 缓存策略在控制台配置：*.css/*.js/*.svg 等长缓存，*.html/*.json/*.md 不缓存
#   - 同样无需任何境外 CDN，依赖已全部自托管
# ============================================================
